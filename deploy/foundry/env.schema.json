{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Submission Evaluation Foundry Environment Schema",
    "type": "object",
    "required": [
        "AZURE_OPENAI_ENDPOINT",
        "AZURE_OPENAI_DEPLOYMENT",
        "AZURE_OPENAI_API_VERSION",
        "WEB_SEARCH_ENDPOINT",
        "INPUT_DIR",
        "OUTPUT_DIR"
    ],
    "properties": {
        "AZURE_OPENAI_ENDPOINT": {
            "type": "string",
            "description": "Azure OpenAI endpoint URL"
        },
        "AZURE_OPENAI_API_KEY": {
            "type": "string",
            "x-secret": true,
            "description": "Azure OpenAI API key"
        },
        "AZURE_OPENAI_DEPLOYMENT": {
            "type": "string",
            "description": "Azure OpenAI deployment name"
        },
        "AZURE_OPENAI_API_VERSION": {
            "type": "string",
            "description": "Azure OpenAI API version"
        },
        "WEB_SEARCH_ENDPOINT": {
            "type": "string",
            "description": "Web search endpoint URL"
        },
        "WEB_SEARCH_API_KEY": {
            "type": "string",
            "x-secret": true,
            "description": "Web search API key"
        },
        "FOUNDRY_PROJECT_ENDPOINT": {
            "type": "string",
            "description": "Foundry project endpoint"
        },
        "FOUNDRY_PROJECT_API_KEY": {
            "type": "string",
            "x-secret": true,
            "description": "Foundry project API key"
        },
        "INPUT_DIR": {
            "type": "string",
            "description": "Input directory for submissions"
        },
        "OUTPUT_DIR": {
            "type": "string",
            "description": "Output directory for generated reports"
        }
    }
}