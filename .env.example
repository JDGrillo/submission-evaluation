# Directories
INPUT_DIR=./input
PROCESSED_DIR=./input/processed
OUTPUT_DIR=./output

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_TPM_TARGET=2000

# Web Search (Bing/Grounding-style endpoint)
WEB_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
WEB_SEARCH_API_KEY=your-web-search-key

# Throughput assumptions for smoke verification (generic placeholders)
EXPECTED_SUBMISSIONS_PER_DAY=10
TOKENS_PER_SUBMISSION=50000
PROCESSING_WINDOW_MINUTES=480

# Secret handling reference:
# Prefer values injected by your CI secret store or Azure Key Vault references.
# Never commit production endpoints, API keys, or subscription-specific secrets.

# Optional Foundry runtime bootstrap
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_PROJECT_API_KEY=

# Optional deployment wrapper command.
# If set, `submission-eval-deploy` will execute this command and pass
# the generated deployment bundle path (or replace {bundle} placeholder).
FOUNDRY_DEPLOY_COMMAND=
